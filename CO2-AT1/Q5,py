from nltk.stem import PorterStemmer

ps = PorterStemmer()

words = []

for i in range(3):
    word = input("Enter word: ")
    words.append(word)

print("\n{:<15}{:<25}{:<20}".format(
    "Word", "Applied Rule", "Final Stem"))

for word in words:

    rule = "No Rule"

    if word.endswith("ational"):
        rule = "Remove 'ational'"

    elif word.endswith("ation"):
        rule = "Remove 'ation'"

    elif word.endswith("ate"):
        rule = "Remove 'e'"

    stem = ps.stem(word)

    print("{:<15}{:<25}{:<20}".format(
        word, rule, stem))